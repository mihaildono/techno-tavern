# Copy to .env (gitignored) and fill in. Used by scripts/social-post.js; how to get the values: CRONS.md §3.
META_PAGE_ID=
# Long-lived Page token: pages_manage_posts, pages_read_engagement, instagram_basic, instagram_content_publish
META_PAGE_TOKEN=
# Instagram business account linked to the Page
META_IG_USER_ID=
# Optional
# META_GRAPH_VERSION=v23.0
# FACEBOOK_IMAGES=cover   # cover | all
# AUTO_POST=1             # let the Pi cron job social-post post automatically
